DATABASE_URL="postgresql://taskboard:taskboard@localhost:5432/taskboard?schema=public"
# Direct Postgres connection for migrations, bypassing PgBouncer (APL-2685). Optional locally: falls back to DATABASE_URL.
# Production must set both: DATABASE_URL is the PgBouncer pool (port 25061, pgbouncer=true) and
# DIRECT_DATABASE_URL is the direct database, used for prisma migrate and the pre-migrate backup.
# DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:25060/DATABASE?sslmode=require"

# Concierge (SHO-US-9.1, 9.2). Off unless MODEL_DATA_APPROVED is exactly "true" and a key is set.
# ANTHROPIC_API_KEY=
# MODEL_DATA_APPROVED=false
# MODEL_NAME=claude-haiku-5-5
# MONTHLY_CEILING_USD=100
# WEEKLY_MESSAGE_CAP=200
