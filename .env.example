DATABASE_URL="postgresql://taskboard:taskboard@localhost:5432/taskboard?schema=public"

# APL-2652. Sign-in return path. Off unless this is exactly 1 or on. No cookie is set.
# SIGNIN_RETURN_TO=on
# Direct Postgres connection for migrations, bypassing PgBouncer (APL-2685). Optional: falls back to DATABASE_URL.
# DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Concierge (SHO-US-9.1, 9.2). Off unless MODEL_DATA_APPROVED is exactly "true" and a key is set.
# SHO-2927: which environment this is. Unset means production (an existing host needs no change).
# Set it to "staging" on a staged host so that host reads ANTHROPIC_API_KEY_STAGE and never the
# production key. Any other value turns the concierge off rather than guessing a key.
# SHO_DEPLOY_STAGE=staging
# ANTHROPIC_API_KEY=
# ANTHROPIC_API_KEY_STAGE=
# MODEL_DATA_APPROVED=false
# MODEL_NAME=claude-haiku-5-5
# MONTHLY_CEILING_USD=100
# WEEKLY_MESSAGE_CAP=200

# Staging mail sink (APL-2681). Commented out: off unless MAIL_SINK is exactly "staging" on a staging host.
# MAIL_SINK=
# MAIL_SINK_TOKEN=
# EMAIL_OUTBOX_DIR=
# SHO_DEPLOY_STAGE=staging
# SHO_SLOT=9

# Comments on tasks (SHO-US-19.1). Off unless set to true. FEATURE_COMMENTS is the same switch.
# FF_TASK_COMMENTS=false
