# Other sites served by the same Caddy, mirrored from the live file.
# DataDataEverywhere unified workspace; native data engine remains on 8080.
datadataeverywhere.aplyd.org {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		X-Frame-Options "DENY"
		X-Robots-Tag "noindex, nofollow"
	}
	request_body {
		max_size 64KB
	}
	@native path /nocodb /nocodb/*
	redir @native https://nocodb.datadataeverywhere.aplyd.org 302
	reverse_proxy 127.0.0.1:3301 {
		flush_interval -1
	}
}

nocodb.datadataeverywhere.aplyd.org {
	encode zstd gzip
	header X-Content-Type-Options "nosniff"
	reverse_proxy 127.0.0.1:8080
}

insightjob.aplyd.org {
	encode zstd gzip
	request_body {
		max_size 25MB
	}
	reverse_proxy 127.0.0.1:8400 {
		header_up X-Forwarded-Proto {scheme}
	}
}
