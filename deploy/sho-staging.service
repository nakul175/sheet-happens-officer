# Reference unit for staging. The workflow does not install this file and does not change Caddy.
# Compare it with the live sho-staging.service. release.sh expects these paths and port 3001.
# The deploy user also needs a sudoers line, added on the droplet by hand:
#   deploy ALL=(root) NOPASSWD: /usr/bin/systemctl restart sho-staging, /usr/bin/journalctl -u sho-staging -n 80 --no-pager
[Unit]
Description=Sheet Happens Officer (staging)
After=network-online.target
Wants=network-online.target

[Service]
User=deploy
Group=deploy
WorkingDirectory=/opt/sho-staging/current
EnvironmentFile=/etc/sho-staging/app.env
EnvironmentFile=/etc/sho-staging/local.env
EnvironmentFile=-/opt/sho-staging/current/release.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p 3001 -H 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
